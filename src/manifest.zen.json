{
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-brave-chat@antigravity",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": ["background/background.js"]
  },
  "sidebar_action": {
    "default_panel": "ui/popup.html",
    "default_title": "Zen & Brave Link Chat",
    "default_icon": "ui/icons/icon-32.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "notifications"
  ]
}
