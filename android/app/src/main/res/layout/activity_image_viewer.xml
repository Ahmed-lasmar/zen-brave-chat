<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootImageViewer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Center Zoomable Image -->
    <ImageView
        android:id="@+id/ivFullPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutViewerBottomBar"
        android:layout_below="@id/layoutViewerTopBar"
        android:adjustViewBounds="true"
        android:contentDescription="Full screen image preview"
        android:scaleType="fitCenter" />

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/layoutViewerTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#DD0E1526"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnViewerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close viewer"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvViewerSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shared Image"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewerMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to zoom • Pinch to resize"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Bar (Open, Save, Share) -->
    <LinearLayout
        android:id="@+id/layoutViewerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#EE0E1526"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Open in Gallery App Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewerOpenExternal"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:paddingHorizontal="8dp"
            android:text="🖼️ Gallery"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Save to Device Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewerSave"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:paddingHorizontal="8dp"
            android:text="💾 Save"
            android:textAllCaps="false"
            android:textColor="@color/accent_brave"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Share Image Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewerShare"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:paddingHorizontal="8dp"
            android:text="↗️ Share"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
